{
  "manifest_version": 3,
  "name": "Surf FED Dark Reader",
  "version": "1.0.0",
  "description": "Built-in dark reader for Surf FED. Inverts bright page colors for easier night reading.",
  "icons": {
    "48": "icon.png"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "Dark Reader"
  }
}
